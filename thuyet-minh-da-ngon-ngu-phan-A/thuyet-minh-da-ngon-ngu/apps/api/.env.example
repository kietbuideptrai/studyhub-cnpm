# Sao chep thanh .env khi chay local
PORT=3000
DATABASE_URL=file:./dev.db
# Danh sach origin duoc phep goi API tu trinh duyet (ngan cach bang dau phay)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# (tuy chon) cho phep moi ban preview cua Vercel: ^https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=
